{
    $schema: "https://docs.renovatebot.com/renovate-schema.json",
    extends: [
        "config:best-practices",
        "security:openssf-scorecard",
        ":automergeDigest",
        ":automergeMinor",
        ":automergePr",
        ":automergeRequireAllStatusChecks",
        ":combinePatchMinorReleases",
        ":docker",
        ":enableVulnerabilityAlerts",
        ":prConcurrentLimitNone",
        ":prImmediately",
        ":rebaseStalePrs",
        ":semanticCommits",
        ":semanticPrefixFixDepsChoreOthers",
        ":separateMajorReleases",
    ],
    // Library crate with no committed lockfile - nothing to maintain.
    lockFileMaintenance: {
        enabled: false,
    },
    packageRules: [
        {
            description: "Use fix prefix for direct cargo dependency updates, including lockfile-only ones",
            matchManagers: ["cargo"],
            matchDepTypes: ["dependencies", "workspace.dependencies"],
            semanticCommitType: "fix",
        },
    ],
}
